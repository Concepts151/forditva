# Firebase project forditva-151. Public values, not secrets.
FIREBASE_PROJECT_NUMBER=851863893438
# Comma-separated if more apps are added later (for example iOS).
FIREBASE_APP_IDS=1:851863893438:android:c740e257fb79717cefb5ef

# Optional. Only accepted from inside the container (docker exec).
# Generate with: openssl rand -hex 32. Leave empty to switch it off.
INTERNAL_TEST_API_KEY=

# Limits (defaults shown).
MAX_UPLOAD_MB=15
MAX_PDF_MB=30
MAX_CONCURRENT=2
TIMEOUT_SECONDS=90
